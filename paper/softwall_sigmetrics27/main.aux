\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Optional NeuralRx\xspace  creates future mandatory work}{3}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Measured recovery debt in the evaluated warm mode (1,200 epochs on two nodes). (a) Retained debts at the 45\nonbreakingspace ms common cutoff for epochs with two transition-SNR TBs, and for 600 four-TB epochs that join the transition TBs of consecutive measured epochs. The dotted line marks the zero debt that current-idle admission sees; the dashed line marks the four recoveries that static reservation holds. (b) Share of epochs, per AI prompt length, in which static reservation rejects a unit that the all-fail certificate admits and in which current-idle admission accepts a unit that breaks the all-fail recovery bound.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:motivation}{{2}{4}{Measured recovery debt in the evaluated warm mode (1,200 epochs on two nodes). (a) Retained debts at the 45~ms common cutoff for epochs with two transition-SNR TBs, and for 600 four-TB epochs that join the transition TBs of consecutive measured epochs. The dotted line marks the zero debt that current-idle admission sees; the dashed line marks the four recoveries that static reservation holds. (b) Share of epochs, per AI prompt length, in which static reservation rejects a unit that the all-fail certificate admits and in which current-idle admission accepts a unit that breaks the all-fail recovery bound}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Measured AI-lease timing in the evaluated warm mode (1,200 epochs on two nodes). (a) Lease length per AI prompt length: the class bound plus the hatched launch-control charge, with measured Qwen prefill from median to maximum. Dashed lines mark the latest lease end that leaves room for $m$ retained debts before the guard. (b) Complementary CDF of the host time to build the launch-time certificate; the dashed line marks the launch-control charge.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:lease-timing}{{3}{4}{Measured AI-lease timing in the evaluated warm mode (1,200 epochs on two nodes). (a) Lease length per AI prompt length: the class bound plus the hatched launch-control charge, with measured Qwen prefill from median to maximum. Dashed lines mark the latest lease end that leaves room for $m$ retained debts before the guard. (b) Complementary CDF of the host time to build the launch-time certificate; the dashed line marks the launch-control charge}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Scheduling failures after two timely successes (TB1, TB2). (a) Current-idle admission pushes a retained recovery past the guard. (b) Static reservation rejects a 128-token AI unit that fits once the successful reservations are released. (c) Per-instance certificates claim one lane interval.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:scheduling-problem}{{4}{5}{Scheduling failures after two timely successes (TB1, TB2). (a) Current-idle admission pushes a retained recovery past the guard. (b) Static reservation rejects a 128-token AI unit that fits once the successful reservations are released. (c) Per-instance certificates claim one lane interval}{figure.caption.6}{}}
