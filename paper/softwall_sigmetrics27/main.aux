\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces SoftWall's online scheduling algorithm. Candidate order controls efficiency; the verifier controls safety. Consequently, a heuristic can be false-conservative but cannot authorize a false-safe state.}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{alg:certify-event}{{8}{10}{SoftWall's online scheduling algorithm. Candidate order controls efficiency; the verifier controls safety. Consequently, a heuristic can be false-conservative but cannot authorize a false-safe state}{figure.caption.11}{}}
