\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Overall architecture}{6}{subsection.3.1}\protected@file@percent }
\newlabel{sec:design-overall}{{3.1}{6}{Overall architecture}{subsection.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces SoftWall\xspace  architecture for one release period. (1) Each owner publishes its NeuralRx\xspace  outcome to a decision page. (2) One outcome batch at the NeuralRx\xspace  deadline updates the pending-recovery table. (3) The scheduler retimes the required recoveries around a candidate AI lease. (4) The independent verifier checks the all-fail schedule, credits, and generation, and commits $X'$ or keeps $X_t$. (5) The coordinator publishes each action with its generation and (6) sends the lease with an absolute latest-start. (7) A completion or non-launch marker retires the lease. The shared lane runs required recoveries in certificate order. The steps are drawn for the evaluated multi-GPU placement (b); the single-GPU placement (a) exchanges IQ, LLR, and TB buffers through CUDA IPC rings and uses the same steps. In (b), cuPHY instance 0 owns TB1--TB3, instance 1 owns TB4 and TB5, and ellipses mark further TBs.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:overall}{{5}{7}{\sys architecture for one release period. (1) Each owner publishes its \NRx outcome to a decision page. (2) One outcome batch at the \NRx deadline updates the pending-recovery table. (3) The scheduler retimes the required recoveries around a candidate AI lease. (4) The independent verifier checks the all-fail schedule, credits, and generation, and commits $X'$ or keeps $X_t$. (5) The coordinator publishes each action with its generation and (6) sends the lease with an absolute latest-start. (7) A completion or non-launch marker retires the lease. The shared lane runs required recoveries in certificate order. The steps are drawn for the evaluated multi-GPU placement (b); the single-GPU placement (a) exchanges IQ, LLR, and TB buffers through CUDA IPC rings and uses the same steps. In (b), cuPHY instance 0 owns TB1--TB3, instance 1 owns TB4 and TB5, and ellipses mark further TBs}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Pending-recovery scheduling}{8}{subsection.3.2}\protected@file@percent }
\newlabel{sec:design-recovery}{{3.2}{8}{Pending-recovery scheduling}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces One transaction on the shared lane. (a) Admission reserves one all-fail recovery per TB and rejects TB5; the 45\nonbreakingspace ms batch cancels two pending recoveries in one generation. (b) The verifier commits the 128-token AI lease and keeps $X_t$ for the 256-token AI lease, whose last recovery would end after the guard. AI units are Qwen prefill requests; hatching marks the 5\nonbreakingspace ms launch-control charge.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:atomic-replan}{{6}{8}{One transaction on the shared lane. (a) Admission reserves one all-fail recovery per TB and rejects TB5; the 45~ms batch cancels two pending recoveries in one generation. (b) The verifier commits the 128-token AI lease and keeps $X_t$ for the 256-token AI lease, whose last recovery would end after the guard. AI units are Qwen prefill requests; hatching marks the 5~ms launch-control charge}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Refinement to physical execution}{9}{subsection.3.3}\protected@file@percent }
\newlabel{sec:design-refinement}{{3.3}{9}{Refinement to physical execution}{subsection.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Refinement of one AI lease. Black steps: commit with a latest-start (1), run request (2), launch gate and launch marker (3), CUDA event and completion marker (4), and retirement on a matching marker (5). Red faults: marker reconciliation after a late reply (1), AI quarantine after channel loss (2), and no-op outcome and response replays (3, 4).}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:refinement}{{7}{9}{Refinement of one AI lease. Black steps: commit with a latest-start (1), run request (2), launch gate and launch marker (3), CUDA event and completion marker (4), and retirement on a matching marker (5). Red faults: marker reconciliation after a late reply (1), AI quarantine after channel loss (2), and no-op outcome and response replays (3, 4)}{figure.caption.10}{}}
