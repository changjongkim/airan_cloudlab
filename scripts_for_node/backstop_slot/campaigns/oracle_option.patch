+    # Clairvoyant baseline (``oracle_candidates``: the number of candidates of every slot, known in advance from a
+    # run without AI of the same seed; not a setting of the scheme).  A neural receiver run of slot k is "needed"
+    # if the candidates of slot k+2 will need its receiver.  AI may run next to the runs that are not needed (such
+    # a run may then hold its receiver for a third slot) and never next to the others.  ``oracle_margin``
+    # receivers are kept free beyond the known demand.
+    oracle = unit_cfg.get("oracle_candidates")
+    oracle_margin = int(unit_cfg.get("oracle_margin", 0))
+    oracle_needed: dict[tuple[int, int], bool] = {}
+    oracle_runs: dict[int, int] = {}       # slot -> neural receiver runs assigned so far
+    oracle_free: dict[int, int] = {}       # slot -> runs of that slot that are not needed
+
+    def oracle_count(j: int) -> int:
+        return int(oracle[j]) if 0 <= j < len(oracle) else 0
+
+    def oracle_mark(cell: int, k: int) -> None:
+        n = len(lanes)
+        oracle_runs[k] = oracle_runs.get(k, 0) + 1
+        # Runs of slot k (each holds its receiver in slot k+1 as well): those assigned so far, or the candidates
+        # of the slot limited by the receivers that were free in it.
+        runs_k = max(oracle_runs[k], min(oracle_count(k), n - oracle_runs.get(k - 1, 0) - oracle_free.get(k - 2, 0)))
+        # Runs of slot k+1 (they hold their receivers in slot k+2): its candidates, limited by the receivers free
+        # then (the runs of slot k and the three-slot runs of slot k-1 still hold theirs).
+        runs_next = min(oracle_count(k + 1), max(0, n - runs_k - oracle_free.get(k - 1, 0)))
+        # Slot k+2 needs oracle_count(k+2) receivers out of the n - runs_next that the runs of slot k+1 leave.
+        allowed = max(0, n - runs_next - oracle_count(k + 2) - oracle_margin)
+        needed = oracle_free.get(k, 0) >= allowed
+        if not needed:
+            oracle_free[k] = oracle_free.get(k, 0) + 1
+        oracle_needed[(cell, k)] = needed
+        name = "oracle_needed" if needed else "oracle_free"
+        counters[name] = counters.get(name, 0) + 1
+
+    def oracle_blocks(g: int) -> bool:
+        """A neural receiver run of GPU g is needed two slots later: no AI next to it."""
+        return oracle is not None and any(oracle_needed.get(lane_job[lane], True) for lane in busy_lanes(g))
